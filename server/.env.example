# JobTrack Server Environment Configuration

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your Atlas connection string (remember to whitelist 0.0.0.0/0 on Atlas for cloud deployments)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jobtrack?retryWrites=true&w=majority
