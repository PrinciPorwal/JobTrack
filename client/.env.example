# JobTrack Client Environment Configuration

# In production (e.g., Vercel / Netlify):
# Set this to your deployed backend service URL:
VITE_API_URL=https://your-jobtrack-backend.onrender.com

# In local development:
# You can leave this empty or commented out to automatically use the Vite proxy (http://localhost:5000)
# VITE_API_URL=http://localhost:5000
